{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ovn.world/schemas/contribution-pie-chart/0.1/schema.json",
  "title": "Contribution Pie-Chart",
  "description": "Schema for OVN License Contribution Pie-Chart files (draft v0.1).",
  "type": "object",
  "required": ["schema_version", "project", "contributors", "metadata"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1",
      "description": "The specification version this file conforms to."
    },
    "project": {
      "type": "object",
      "required": ["name", "repository", "license_version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "The project name."
        },
        "repository": {
          "type": "string",
          "minLength": 1,
          "description": "URL of the project's source repository."
        },
        "license_version": {
          "type": "string",
          "minLength": 1,
          "description": "The OVN License version (e.g., '1.0')."
        }
      },
      "additionalProperties": false
    },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "identifier", "share"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The contributor's display name."
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "description": "A unique, stable identifier (email, URL, DID, or platform ID)."
          },
          "share": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100,
            "description": "The contributor's share as a percentage (0 < share <= 100)."
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Descriptions of the contributor's roles."
          }
        },
        "additionalProperties": false
      },
      "description": "Array of contributor objects. Identifiers must be unique."
    },
    "metadata": {
      "type": "object",
      "required": ["created", "last_updated", "governance", "dispute_resolution"],
      "properties": {
        "created": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 date when the pie-chart was created."
        },
        "last_updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "ISO 8601 date of the most recent update."
        },
        "governance": {
          "type": "string",
          "minLength": 1,
          "description": "How pie-chart updates are governed."
        },
        "dispute_resolution": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to the dispute resolution process."
        }
      },
      "additionalProperties": false
    },
    "organization": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Organization name."
        },
        "url": {
          "type": "string",
          "description": "Organization website."
        },
        "type": {
          "type": "string",
          "description": "Organization type (e.g., 'cooperative', 'association', 'value network')."
        }
      },
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "description"],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "ISO 8601 date of the change."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What changed and why."
          },
          "shares_snapshot": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Snapshot of { identifier: share } at the time of the change."
          }
        },
        "additionalProperties": false
      },
      "description": "Change history for the pie-chart."
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "type": "object"
      },
      "description": "Platform-specific extension namespaces (e.g., 'holochain', 'ethereum')."
    }
  },
  "additionalProperties": false
}
